{
    "openapi": "3.0.0",
    "info": {
        "title": "PrepYourMeal API",
        "description": "API documentation and testing interface for PrepYourMeal.",
        "version": "1.0.0"
    },
    "paths": {
        "/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Local password login (for testing)",
                "operationId": "99d66635c4992aeaa6aa44ff653d0563",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful, returns Sanctum token"
                    },
                    "401": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
        "/auth/{provider}/redirect": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Get the OAuth redirect URL for the frontend",
                "operationId": "c7031d1ebe15dc495bb564836d13e6ce",
                "parameters": [
                    {
                        "name": "provider",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "github",
                                "google"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Returns the URL to redirect the user to"
                    }
                }
            }
        },
        "/auth/{provider}/callback": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Handle OAuth callback from provider",
                "operationId": "f4cc2f01c0cd520f583d75d9b4600daa",
                "parameters": [
                    {
                        "name": "provider",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "github",
                                "google"
                            ]
                        }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redirects back to PWA with token"
                    }
                }
            }
        },
        "/plan": {
            "get": {
                "tags": [
                    "Meal Plan"
                ],
                "summary": "Get the currently active meal plan",
                "operationId": "96e3394c6ed9a5c8a0416f1a5b48fe83",
                "responses": {
                    "200": {
                        "description": "Current meal plan data"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/plan/generate": {
            "post": {
                "tags": [
                    "Meal Plan"
                ],
                "summary": "Generate a new 7-day meal plan",
                "operationId": "9c792e3e445b1d853dfbea7f52d268ee",
                "responses": {
                    "200": {
                        "description": "Generated meal plan"
                    },
                    "400": {
                        "description": "Not enough unused recipes available"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/shopping-list": {
            "get": {
                "tags": [
                    "Shopping"
                ],
                "summary": "Get the smart shopping list",
                "operationId": "7b8ae419230f29c2323de9dbc985b108",
                "parameters": [
                    {
                        "name": "portions",
                        "in": "query",
                        "description": "Number of portions to calculate (default: 1)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Categorized shopping list"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/version": {
            "get": {
                "tags": [
                    "System"
                ],
                "summary": "Get the current API version",
                "description": "Reads the version hash directly from the version.txt file.",
                "operationId": "7c2a07f83d029ec82d165f1a255a9e62",
                "responses": {
                    "200": {
                        "description": "Returns the current version string"
                    }
                }
            }
        },
        "/webhooks/github": {
            "post": {
                "tags": [
                    "System"
                ],
                "summary": "Synchronize recipes from GitHub",
                "operationId": "c078c3fdf9abeb1fc6e7fd5d0bd544a4",
                "parameters": [
                    {
                        "name": "X-Hub-Signature-256",
                        "in": "header",
                        "description": "HMAC hex digest of the payload",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful synchronization"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Meal Plan",
            "description": "Meal Plan"
        },
        {
            "name": "Shopping",
            "description": "Shopping"
        },
        {
            "name": "System",
            "description": "System"
        }
    ]
}